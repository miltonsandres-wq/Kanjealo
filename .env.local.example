# ═══════════════════════════════════════
# Kanjealo — Variables de Entorno
# ═══════════════════════════════════════
# Copia este archivo como .env.local y completa los valores

# ── Modo Demo ──
# Activa datos ficticios sin servicios externos
NEXT_PUBLIC_DEMO_MODE=true

# ── Clerk (Autenticación) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe ── (bloqueado: Stripe no opera cuentas domiciliadas en Honduras)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BASIC=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ── PayPal (reemplaza a Stripe) ──
# Client ID y Secret salen de la app creada en developer.paypal.com
# (modo Sandbox primero, luego Live cuando la cuenta esté lista).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Client ID público para el botón de checkout en el navegador (mismo valor
# que PAYPAL_CLIENT_ID, pero expuesto porque el SDK de PayPal corre en el cliente).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID del webhook configurado en el dashboard de PayPal (Apps & Credenciales > tu app > Webhooks).
PAYPAL_WEBHOOK_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Plan IDs creados en PayPal (Billing Plans), uno por cada plan de Kanjealo.
NEXT_PUBLIC_PAYPAL_PLAN_BASIC=P-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYPAL_PLAN_PRO=P-xxxxxxxxxxxxxxxxxxxxxxxx

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
